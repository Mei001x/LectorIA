{
  "manifest_version": 3,
  "name": "Oye Lector",
  "version": "0.1.1",
  "description": "Extensión que lee páginas web en voz alta y responde preguntas de comprensión.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
