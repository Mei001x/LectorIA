# Copia este archivo a ".env" y completa tus valores reales.
# Nunca subas el archivo ".env" real al repositorio.

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar. gemini-3-flash-preview es una alternativa mas
# nueva si prefieres probar la ultima generacion.
GEMINI_MODEL=gemini-3.1-flash-lite

# Puerto en el que escucha el servidor local
PORT=3000

# Origenes permitidos ademas de chrome-extension://*, separados por coma.
# Util para probar el backend desde una pagina web normal (http://localhost:xxxx).
EXTRA_ALLOWED_ORIGINS=

# Limite de solicitudes por IP cada 15 minutos (protege tu cuota de la API)
RATE_LIMIT_MAX=60
